{
  "info": {
    "name": "Plazoleta | HU1-HU17",
    "description": "Colección integrada para probar HU1-HU17 en la aplicación unificada (puerto 8080). El primer administrador puede crearse sin token si aún no existe y el cupo sigue libre; también puede aprovisionarse al iniciar la aplicación con BOOTSTRAP_ADMIN_EMAIL/BOOTSTRAP_ADMIN_PASSWORD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Preparación",
      "item": [
        {
          "name": "Inicialización - Crear primer administrador (solo si no existe)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = Date.now().toString();",
                  "pm.environment.set('adminNuevoCorreo', `admin.${stamp}@example.com`);",
                  "pm.environment.set('adminNuevoDocumento', `${stamp}9`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Primer administrador creado o el cupo ya esta ocupado', function () { pm.expect([201, 409]).to.include(pm.response.code); });",
                  "if (pm.response.code === 201) {",
                  "  pm.environment.set('idAdminCreado', pm.response.json().id);",
                  "  pm.environment.set('adminCorreo', pm.environment.get('adminNuevoCorreo'));",
                  "  pm.environment.set('adminClave', pm.environment.get('adminNuevoClave'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Administrador\",\n  \"apellido\": \"Demo\",\n  \"documentoDeIdentidad\": \"{{adminNuevoDocumento}}\",\n  \"celular\": \"+573001234560\",\n  \"correo\": \"{{adminNuevoCorreo}}\",\n  \"clave\": \"{{adminNuevoClave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{usuariosBaseUrl}}/administradores"
          }
        },
        {
          "name": "Salud - Plazoleta",
          "request": {
            "method": "GET",
            "url": "{{plazoletaBaseUrl}}/actuator/health"
          }
        },
        {
          "name": "HU5 - Login administrador existente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login de administrador responde 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('tokenAdmin', body.token);",
                  "  pm.environment.set('idAdmin', body.idUsuario);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"clave\": \"{{adminClave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{usuariosBaseUrl}}/login"
          }
        }
      ]
    },
