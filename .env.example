# Referencia de valores. Copialos al entorno local del proceso; Spring no carga este archivo.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/plazoleta_bd
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=enter-locally-do-not-commit
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SQL_LOGGING=true

# Solo para crear el primer administrador por API. Por defecto esta desactivado.
ADMIN_REGISTRATION_ENABLED=false

# Alternativa: crear el primer administrador al arrancar (clave de minimo 12 caracteres).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
