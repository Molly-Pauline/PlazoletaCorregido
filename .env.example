# AUTH_SECRET debe coincidir con el servicio Usuarios y tener al menos 16 caracteres.
AUTH_SECRET=replace-with-a-shared-secret-of-at-least-32-characters

# El servicio Usuarios necesita implementar el endpoint documentado en docs/contrato-usuarios.md.
USUARIOS_BASE_URL=http://localhost:8081
USUARIOS_OWNER_VALIDATION_PATH=/api/v1/usuarios/{id}/validacion-propietario

# Opcional: sin URL se utiliza H2 en memoria.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/plazoleta
SPRING_DATASOURCE_USERNAME=plazoleta
SPRING_DATASOURCE_PASSWORD=replace-me
DDL_AUTO=update